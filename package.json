{
  "name": "window-ml",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "fetch-pyodide": "node scripts/fetch-pyodide-wheels.mjs",
    "gen-api-docs": "node scripts/gen-api-docs.mjs",
    "gen-build-info": "node scripts/gen-build-info.mjs",
    "typecheck": "npm run gen-api-docs && npm run gen-build-info && tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "pretest": "npm run build",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.js tests/*.test.mjs",
    "test:core": "node scripts/test.mjs core",
    "test:panel": "node scripts/test.mjs panel",
    "test:ext": "node scripts/test.mjs ext",
    "test:python": "node scripts/test.mjs python",
    "test:timings": "node scripts/test.mjs --timings",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "precoverage": "npm run build",
    "coverage": "node --import tsx --test --enable-source-maps --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout --test-concurrency=1 tests/*.test.js tests/*.test.mjs",
    "coverage:lines": "node scripts/coverage-lines.mjs",
    "gen-export-schema": "node scripts/gen-export-schema.mjs",
    "bench": "node --import tsx tests/e2e/bench/run.mjs",
    "bench:calibrate": "npm run build && node --import tsx tests/e2e/bench/run.mjs tests/e2e/bench/specs/smoke.bench.ts --repeats 1 --no-cache && node tests/e2e/bench/check-calibration.mjs",
    "check-format": "node scripts/check-format.mjs",
    "lint": "npm run check-format && npm run typecheck",
    "gen-proto": "node scripts/gen-proto.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "marked": "^18.0.11",
    "pyodide": "^314.0.3",
    "ts-proto": "^2.12.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@preact/signals": "^2.9.3",
    "@types/turndown": "^5.0.6",
    "acorn": "^8.18.0",
    "highlight.js": "^11.11.1",
    "js-beautify": "^2.0.3",
    "katex": "^0.18.1",
    "preact": "^10.29.7",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
