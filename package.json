{
    "name": "window-ml",
    "private": true,
    "scripts": {
        "build": "node build.mjs",
        "watch": "node build.mjs --watch",
        "fetch-pyodide": "node scripts/fetch-pyodide-wheels.mjs",
        "gen-api-docs": "node scripts/gen-api-docs.mjs",
        "gen-build-info": "node scripts/gen-build-info.mjs",
        "typecheck": "npm run gen-api-docs && npm run gen-build-info && tsc --noEmit",
        "pretest": "npm run build",
        "test": "node --import tsx --test --test-concurrency=1 tests/*.test.js tests/*.test.mjs",
        "pretest:e2e": "npm run build",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@playwright/test": "^1.50.1",
        "@types/chrome": "^0.2.2",
        "esbuild": "^0.28.1",
        "jsdom": "^29.1.1",
        "pyodide": "^314.0.3",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@preact/signals": "^2.9.3",
        "highlight.js": "^11.11.1",
        "js-beautify": "^2.0.3",
        "katex": "^0.18.1",
        "preact": "^10.29.7"
    }
}
