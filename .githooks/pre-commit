#!/bin/sh
# Pre-commit: the two checks that are fast enough to run every time, on STAGED files only.
#
# Enable once per clone (hooks are not shared by git automatically):
#
#     git config core.hooksPath .githooks
#
# Skip a single commit with `git commit --no-verify` — for a WIP commit on your own branch, that is the
# right call rather than fighting the hook.
#
# Deliberately NOT in here: `npm test` (~100s), the e2e suite (minutes), and any formatter. A hook that
# takes two minutes gets disabled, and a hook that rewrites your staged files hands you a commit you did
# not read. CI is where the slow checks belong; this only catches what is both instant and unambiguous.

set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# A git WORKTREE does not get node_modules, and this repo is often worked in several at once — so a
# missing install is a normal state, not an error. Without this the hook died on `tsc: command not found`
# and blamed the typecheck, which is a confusing way to learn you needed `npm ci`. (Found by the hook
# doing exactly that on its own commit.)
#
# A FLAG rather than an early exit, so each check below decides for itself: only the typecheck needs an
# install. The whitespace check and the schema regeneration are plain node reading files, and skipping
# them here would silently weaken the hook in exactly the worktrees this repo is usually worked in.
HAVE_DEPS=1
if [ ! -d node_modules ]; then
    HAVE_DEPS=0
    echo "pre-commit: no node_modules here (a fresh worktree?) — the typecheck will be skipped."
    echo "            install with \`npm ci\` (a symlink works until a dependency changes)."
fi

# 1. Whitespace invariants (.editorconfig), reported not rewritten.
if ! node scripts/check-format.mjs --staged; then
    echo ""
    echo "pre-commit: whitespace. Fix with:  node scripts/check-format.mjs --staged --fix"
    echo "            then re-stage. Or commit with --no-verify."
    exit 1
fi

# 2. The generated JSON Schema. `docs/spec/export.schema.json` is CHECKED IN — it is a published contract
#    that people link to and generate parsers from — so it can go stale the moment src/export-schema.ts or
#    src/contract.ts changes and nobody reruns the generator. CI catches that (tests/export-schema.test.mjs
#    diffs it), but finding out from CI means a round trip for something a 40ms regeneration settles here.
#
#    Regenerated unconditionally: it needs no node_modules (plain node reading two files) and costs ~40ms,
#    so gating it on which files are staged would be more code than it saves. The generator only WRITES on
#    change, so on a normal commit this is a no-op.
#
#    CI already blocks a stale schema — tests/export-schema.test.mjs regenerates and diffs, in the `test`
#    job on all three Node versions (verified: it fails on exactly this state). This hook is not a second
#    gate, it is the same gate arriving 6 minutes earlier and pointing at the fix.
if ! node scripts/gen-export-schema.mjs >/dev/null 2>&1; then
    echo "pre-commit: the JSON Schema generator FAILED. It throws rather than emitting a partial schema —"
    echo "            usually a type in export-schema.ts it cannot map. Run it to see:"
    echo "                node scripts/gen-export-schema.mjs"
    exit 1
fi
# Working tree vs INDEX. Non-empty means the regenerated file is not what is about to be committed —
# either it was never staged, or it was staged before an edit that changed the output. Both are the same
# mistake and the same fix.
if ! git diff --quiet -- docs/spec/export.schema.json; then
    echo "pre-commit: docs/spec/export.schema.json is out of date with the schema you are committing."
    echo ""
    git --no-pager diff --stat -- docs/spec/export.schema.json | sed 's/^/            /'
    echo ""
    echo "            It regenerated differently from the staged copy, so a consumer would be handed a"
    echo "            contract that does not describe what this commit emits. Stage it:"
    echo "                git add docs/spec/export.schema.json"
    exit 1
fi

# 3. Types, but only when a typed source actually changed — `tsc` on this project is a few seconds, which
#    is worth paying for a contract.ts edit and not worth paying for a README one.
if [ "$HAVE_DEPS" = "1" ] && echo "$staged" | grep -qE '\.(ts|tsx)$'; then
    if ! npm run --silent typecheck; then
        echo ""
        echo "pre-commit: typecheck failed. The core is strict, and its types are what gen-api-docs.mjs"
        echo "            lifts into what the AGENT reads — a wrong type there ships a wrong doc."
        exit 1
    fi
fi

# 4. The component index can still find what this commit adds. Two checks, both instant (plain node reading
#    files, no node_modules), and both only about what YOU are adding — the stylesheet has 300+ classes with
#    no comment and that backlog is not this commit's problem.
#
#    Gated on the staged files, unlike the schema above: that one is ~40ms and regenerates in place, while
#    these two shell out to git and print a list, so running them for a README edit is noise.
if echo "$staged" | grep -qE '^src/sidebar/.*\.(ts|tsx)$'; then
    if ! node scripts/components.mjs --undocumented >/dev/null; then
        echo ""
        node scripts/components.mjs --undocumented || true
        echo ""
        echo "pre-commit: an undocumented export is INVISIBLE to \`node scripts/components.mjs | grep -i <concept>\`,"
        echo "            so the next person rebuilds it — which is the whole failure the index exists to stop."
        echo "            One sentence saying what it is FOR, in words someone would search."
        exit 1
    fi
fi
if echo "$staged" | grep -q '^src/sidebar/sidebar\.css$'; then
    # Against the MERGE BASE, not the previous commit: a branch's second commit should not be asked about
    # classes its first commit added and already answered for.
    base=$(git merge-base HEAD origin/main 2>/dev/null || echo "")
    if [ -n "$base" ] && ! node scripts/components.mjs --new-css "$base" --staged; then
        echo ""
        echo "pre-commit: a new CSS FAMILY with nothing to search on. A member of a documented block is fine"
        echo "            (.r-diff-head inherits .r-diff) — this is only asking about names nobody would grep."
        exit 1
    fi
fi
