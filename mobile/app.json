{
  "expo": {
    "name": "window.ml",
    "slug": "window-ml",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.wander.windowml"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.wander.windowml"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-sharing",
      "./plugins/with-ios-scene",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a device's pairing code, and take photos to attach to a message.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos to a message you send to a session.",
          "cameraPermission": "Scan a device's pairing code, and take photos to attach to a message."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ]
    ]
  }
}
