node_modules
.DS_Store
.env
__pycache__
*.log
dist/
# The staging directory a build writes into before swapping it over dist/ — present only mid-build, or
# left behind by a build that FAILED (which is the point: the failure did not touch dist/).
dist.stage/
tmp/
# Generated, ANYWHERE — not `src/…` specifically. Pinning the path is how the stale root-level copies
# got committed: the src/ move repointed this at src/, the pre-move leftovers at the root stopped
# being ignored, and the next `git add -A` swept them in as tracked dead files.
*.gen.ts
tools/annotate-preview.html
tools/legend-notebook.html
pyodide-wheels

# Playwright E2E output
test-results/
playwright-report/
tests/e2e/artifacts/

# subagent worktrees (ephemeral)
.claude/worktrees/

window-ml.code-workspace

# coverage runs (regenerate with the `coverage` skill)
coverage/
