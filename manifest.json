{
    "manifest_version": 3,
    "name": "window.ml",
    "version": "1.0",
    "permissions": ["scripting", "activeTab", "storage", "offscreen"],
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "host_permissions": [
      "<all_urls>"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "devtools_page": "devtools.html",
    "action": {
      "default_popup": "popup.html",
      "default_title": "window.ml"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js", "sidebar-shell.js"]
      }
    ],
    "web_accessible_resources": [
      {
        "resources": ["injected.js", "sidebar.html", "sidebar-app.js", "sidebar.css"],
        "matches": ["<all_urls>"]
      }
    ]
  }
