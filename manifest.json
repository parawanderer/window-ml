{
    "manifest_version": 3,
    "name": "window.ml",
    "version": "1.0",
    "permissions": ["scripting", "activeTab", "storage", "offscreen", "debugger"],
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "host_permissions": [
      "<all_urls>"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "devtools_page": "devtools.html",
    "action": {
      "default_popup": "popup.html",
      "default_title": "window.ml"
    },
    "commands": {
      "open-composer": {
        "suggested_key": { "default": "Alt+Space", "mac": "Alt+Space" },
        "description": "Open the window.ml command bar (start an agent task)"
      }
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["shadow-patch.js"],
        "run_at": "document_start",
        "world": "MAIN"
      },
      {
        "matches": ["<all_urls>"],
        "js": ["content.js", "sidebar-shell.js"]
      }
    ],
    "web_accessible_resources": [
      {
        "resources": ["injected.js", "sidebar.html", "sidebar-app.js", "sidebar.css", "fonts/*"],
        "matches": ["<all_urls>"]
      }
    ]
  }
