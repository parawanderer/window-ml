{
    "manifest_version": 3,
    "name": "window.ml",
    "version": "1.0",
    "incognito": "spanning",
    "permissions": ["scripting", "activeTab", "storage", "offscreen", "debugger", "contextMenus", "webNavigation", "alarms", "unlimitedStorage", "userScripts", "nativeMessaging", "webRequest"],
    "optional_permissions": ["tabGroups"],
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
      "sandbox": "sandbox allow-scripts; script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    },
    "sandbox": {
      "pages": ["mermaid.html"]
    },
    "host_permissions": [
      "<all_urls>"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "devtools_page": "devtools.html",
    "action": {
      "default_popup": "popup.html",
      "default_title": "window.ml"
    },
    "commands": {
      "open-composer": {
        "suggested_key": { "default": "Alt+Space", "mac": "Alt+Space" },
        "description": "Open the window.ml command bar (start an agent task)"
      }
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "run_at": "document_start"
      },
      {
        "matches": ["<all_urls>"],
        "js": ["sidebar-shell.js"]
      }
    ],
    "web_accessible_resources": [
      {
        "resources": ["sidebar.html", "sidebar-app.js", "sidebar.css", "mermaid.html", "mermaid-frame.js", "fonts/*"],
        "matches": ["<all_urls>"],
        "use_dynamic_url": true
      }
    ]
  }
